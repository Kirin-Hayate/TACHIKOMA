# ==============================================================================
# 1. 環境変数・APIキー設定ファイル（機密情報）
# ==============================================================================
.env
.env.local
.env.*.local
*.pem
*.key

# ==============================================================================
# 2. Python 実行時生成物・仮想環境
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
build/
dist/
*.egg-info/

# ==============================================================================
# 3. エディタ・OS固有の一時ファイル
# ==============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
desktop.ini
Thumbs.db
.DS_Store

# ==============================================================================
# 4. TACHIKOMA 動的生成ステート・ログ
# ==============================================================================
# リアルタイム更新される世界地図ステート
config/current_world_state.json

# ログファイルおよび MuJoCo 出力ログ
logs/
*.log
MUJOCO_LOG.TXT

# 一時ファイル (VisionPipelineのアトミック書き込み用等)
tmp/
*.tmp

# ==============================================================================
# 5. テスト生成モーションCSV (固定の基準CSV以外を除外)
# ==============================================================================
# テスト実行時に自動生成されるタイムスタンプ付きCSV
motions/task_*.csv
motions/motion_plan_*.csv
motions/*_[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_*.csv

# ==============================================================================
# 6. 画像・動画データ全般 (テスト用静止画・マーカーのみ例外許可)
# ==============================================================================
# 生成される画像・撮影フレームの除外
*.jpg
*.jpeg
*.png
*.bmp
*.mjpg

# キャプチャ保存フォルダ
data/camera_captures/*
!data/camera_captures/.gitkeep

# 【例外許可】検証に必須なサンプル画像とArUcoマーカーはリポジトリに残す
#!data/sample_tabletop_photo/
#!data/sample_tabletop_photo/*
!assets/markers/
!assets/markers/*